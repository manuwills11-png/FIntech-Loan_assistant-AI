# ──────────────────────────────────────────────
# FinEdge Loan – Backend Environment Configuration
# Copy this file to .env and fill in your keys (local dev).
# In production (Render), set these in the Render dashboard instead —
# see render.yaml for the full list Render expects.
# ──────────────────────────────────────────────

# CORS – comma-separated list of allowed frontend origins.
# REQUIRED in production — the backend no longer defaults to "*".
# If left unset, it falls back to http://localhost:3000 for local dev only.
# In production, set to your deployed Vercel URL:
#   ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Groq (recommended – free tier, very fast, uses Llama 3). Used for chat,
# risk advice, roadmap narrative, and Whisper voice transcription.
# Get key: https://console.groq.com → API Keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama3-groq-70b-8192-tool-use-preview

# Google Gemini (chat/advice fallback, voice transcription fallback,
# document OCR). Get key: https://aistudio.google.com → Get API Key
GEMINI_API_KEY=AIza...

# OpenAI (third-tier fallback if neither Groq nor Gemini is set)
OPENAI_API_KEY=sk-...

# Twilio WhatsApp — used for reminders and the /send-whatsapp endpoint.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your Twilio sandbox join word (dev only), used by GET /send-whatsapp/join-link
TWILIO_SANDBOX_WORD=your-sandbox-word

# ML Model path (relative to backend/)
MODEL_PATH=./ml/loan_risk_model.pkl

# ─────────────────────────────────────────────────────────────────
# NOT CURRENTLY USED — no code path in backend/app reads these.
# Kept here only in case they're wired up later; safe to leave unset.
# ─────────────────────────────────────────────────────────────────
# APP_ENV=development
# APP_SECRET_KEY=your-secret-key-here
# SCHEDULER_TIMEZONE=Asia/Kolkata            # scheduler hardcodes Asia/Kolkata in code
# WHATSAPP_ACCESS_TOKEN=your_meta_access_token_here    # Meta WhatsApp Cloud API — not implemented, only Twilio is
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here   # Meta WhatsApp Cloud API — not implemented, only Twilio is
# GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json  # no Google Cloud SDK usage found; OCR uses GEMINI_API_KEY instead
